{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsolkcb.github.io/AI-CONTEXT/spec/routing-policy.schema.json",
  "title": "AI-CONTEXT Routing Policy",
  "type": "object",
  "required": ["protocol", "schema_version", "default_target", "targets", "global_hard_exclusions"],
  "properties": {
    "protocol": {"const": "AI-CONTEXT/ROUTING-POLICY"},
    "schema_version": {"const": "0.1.0"},
    "default_target": {"type": "string", "minLength": 1},
    "global_hard_exclusions": {"$ref": "disclosure-exclusions.schema.json"},
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "enabled",
          "max_sensitivity",
          "min_confidence",
          "allowed_record_types",
          "denied_record_types",
          "denied_tags",
          "denied_epistemic_states",
          "require_verified_record_types",
          "require_curation_application",
          "hard_exclusions"
        ],
        "properties": {
          "kind": {"enum": ["provider", "local_model"]},
          "enabled": {"type": "boolean"},
          "description": {"type": "string"},
          "max_sensitivity": {"enum": ["public", "private", "restricted"]},
          "min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "allowed_record_types": {
            "type": "array",
            "items": {"enum": ["fact", "preference", "project_state", "decision", "claim", "hypothesis", "instruction", "relationship", "publication", "event", "environment", "provenance_policy"]},
            "uniqueItems": true
          },
          "denied_record_types": {
            "type": "array",
            "items": {"enum": ["fact", "preference", "project_state", "decision", "claim", "hypothesis", "instruction", "relationship", "publication", "event", "environment", "provenance_policy"]},
            "uniqueItems": true
          },
          "denied_tags": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "denied_epistemic_states": {
            "type": "array",
            "items": {"enum": ["observed", "retrieved", "parsed", "inferred", "remembered", "user_asserted", "verified", "unknown"]},
            "uniqueItems": true
          },
          "require_verified_record_types": {
            "type": "array",
            "items": {"enum": ["fact", "preference", "project_state", "decision", "claim", "hypothesis", "instruction", "relationship", "publication", "event", "environment", "provenance_policy"]},
            "uniqueItems": true
          },
          "require_curation_application": {"type": "boolean"},
          "hard_exclusions": {"$ref": "disclosure-exclusions.schema.json"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
