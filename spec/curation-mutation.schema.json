{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsolkcb.github.io/AI-CONTEXT/spec/curation-mutation.schema.json",
  "title": "AI-CONTEXT Curation Mutation Receipt",
  "type": "object",
  "required": ["id", "protocol", "schema_version", "memory_id", "revision", "previous_mutation_id", "kind", "patch", "before_sha256", "after_sha256", "actor", "reason", "evidence_refs", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^mutation\\.sha256:[0-9a-f]{64}$"},
    "protocol": {"const": "AI-CONTEXT/CURATION-MUTATION"},
    "schema_version": {"const": "0.1.0"},
    "memory_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "previous_mutation_id": {"type": ["string", "null"], "pattern": "^mutation\\.sha256:[0-9a-f]{64}$"},
    "kind": {"enum": ["confidence_update", "verification", "retention_set", "expire", "supersede", "tombstone"]},
    "patch": {
      "type": "object",
      "properties": {
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "epistemic_state": {"enum": ["observed", "retrieved", "parsed", "inferred", "remembered", "user_asserted", "verified", "unknown"]},
        "last_verified": {"type": ["string", "null"]},
        "lifecycle": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": {"enum": ["active", "expired", "superseded", "tombstoned"]},
            "expires_at": {"type": ["string", "null"]},
            "supersedes": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor": {"type": "object", "required": ["type", "label"], "properties": {"type": {"enum": ["human", "policy"]}, "label": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^obs\\.sha256:[0-9a-f]{64}$"}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
