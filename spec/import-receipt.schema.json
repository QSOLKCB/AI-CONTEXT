{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsolkcb.github.io/AI-CONTEXT/spec/import-receipt.schema.json",
  "title": "AI-CONTEXT Import Receipt",
  "type": "object",
  "required": [
    "id",
    "protocol",
    "schema_version",
    "source_type",
    "source_identity_sha256",
    "requested_adapter",
    "adapter",
    "parse_status",
    "observation_count",
    "warnings"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^import\\.sha256:[0-9a-f]{64}$"},
    "protocol": {"const": "AI-CONTEXT/IMPORT"},
    "schema_version": {"const": "0.1.0"},
    "source_type": {"type": "string", "minLength": 1},
    "source_name": {"type": "string"},
    "source_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_adapter": {
      "oneOf": [
        {"enum": ["auto", "repo", "chatgpt", "claude", "generic-json", "gemini", "grok", "browser-chat"]},
        {"type": "string", "pattern": "^plugin:[0-9a-f]{64}$"},
        {"type": "string", "pattern": "^evidence:(repo|document|drive-export|email):snapshot\\.sha256:[0-9a-f]{64}$"}
      ]
    },
    "adapter": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"const": "0.1.0"}
      },
      "additionalProperties": false
    },
    "adapter_layout": {"type": "string", "minLength": 1},
    "parse_status": {"enum": ["exact", "partial", "generic", "failed"]},
    "observation_count": {"type": "integer", "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "imported_at": {"type": ["string", "null"], "format": "date-time"},
    "source_snapshot_id": {"type": "string", "pattern": "^snapshot\\.sha256:[0-9a-f]{64}$"},
    "content_object_count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
