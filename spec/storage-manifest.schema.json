{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsolkcb.github.io/AI-CONTEXT/spec/storage-manifest.schema.json",
  "title": "AI-CONTEXT Storage Manifest",
  "type": "object",
  "required": ["protocol", "schema_version", "store_id", "backend", "algorithm", "active_key_id", "key_history", "created_at", "updated_at"],
  "properties": {
    "protocol": {"const": "AI-CONTEXT/STORAGE-MANIFEST"},
    "schema_version": {"const": "0.1.0"},
    "store_id": {"type": "string", "pattern": "^store\\.[0-9a-f]{32}$"},
    "backend": {"const": "encrypted-directory"},
    "algorithm": {"const": "AES-256-GCM"},
    "active_key_id": {"type": "string", "pattern": "^key\\.sha256:[0-9a-f]{64}$"},
    "key_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key_id", "status", "activated_at", "retired_at", "replaced_by"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^key\\.sha256:[0-9a-f]{64}$"},
          "status": {"enum": ["active", "retired"]},
          "activated_at": {"type": "string", "format": "date-time"},
          "retired_at": {"type": ["string", "null"], "format": "date-time"},
          "replaced_by": {"type": ["string", "null"], "pattern": "^key\\.sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
