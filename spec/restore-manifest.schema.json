{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsolkcb.github.io/AI-CONTEXT/spec/restore-manifest.schema.json",
  "title": "AI-CONTEXT Portable Restore Manifest",
  "type": "object",
  "required": [
    "snapshot_id",
    "protocol",
    "schema_version",
    "workspace_protocol_version",
    "continuity_class",
    "restore_claim",
    "provider_memory_dependency",
    "created_at",
    "migration_manifest_sha256",
    "artifacts"
  ],
  "properties": {
    "snapshot_id": {"type": "string", "pattern": "^restore\\.sha256:[0-9a-f]{64}$"},
    "protocol": {"const": "AI-CONTEXT/RESTORE-MANIFEST"},
    "schema_version": {"const": "0.1.0"},
    "workspace_protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "continuity_class": {"enum": ["minimum", "full"]},
    "restore_claim": {"const": "context-continuity-not-model-identity"},
    "provider_memory_dependency": {"const": "none"},
    "created_at": {"type": "string", "format": "date-time"},
    "migration_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "class", "sha256", "bytes", "required"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
          "class": {
            "enum": [
              "workspace_policy",
              "canonical_memory",
              "profile",
              "routing_policy",
              "curation_state",
              "source_evidence",
              "receipt",
              "style_culture_enrichment"
            ]
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 134217728},
          "required": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "description": "Non-authoritative additive metadata. Ignored for snapshot identity and restore authority."
    }
  },
  "additionalProperties": false
}
